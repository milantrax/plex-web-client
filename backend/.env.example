PORT=3001
SESSION_SECRET=change-this-to-a-random-secret-in-production
DATABASE_URL=postgresql://localhost:5432/plex

# Holds the login sessions and the cached Plex responses. The API will not
# start without it. Defaults to redis://127.0.0.1:6379 when unset.
REDIS_URL=redis://127.0.0.1:6379

# Set to false to stop serving the interactive API reference at /api/docs.
API_DOCS_ENABLED=true

# Starting theme for a browser that has not picked one yet: light, dark, or
# system (default: follow the viewer's device).
DEFAULT_THEME=system

DEFAULT_PLEX_URL=http://your-plex-server-ip:32400
DEFAULT_PLEX_TOKEN=your-plex-token-here
