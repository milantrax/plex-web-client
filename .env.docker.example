# Docker Compose configuration.
# Copy these into the root .env (compose reads it automatically) and adjust.

# --- Postgres ('db' service) ---
POSTGRES_USER=plex
POSTGRES_PASSWORD=plex
POSTGRES_DB=plex

# --- Backend ('backend' service) ---
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-random-secret-in-production
# Set to true only when the stack is served over HTTPS.
COOKIE_SECURE=false
# Fallback Plex server used for accounts without their own credentials.
DEFAULT_PLEX_URL=http://your-plex-server-ip:32400
DEFAULT_PLEX_TOKEN=your-plex-token-here

# --- Published ports ---
FRONTEND_PORT=8088
# BACKEND_PORT=3001   # only used if you uncomment the backend ports mapping
# DB_PORT=5432        # only used if you uncomment the db ports mapping
