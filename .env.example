# Docker Compose configuration for the three-container stack.
#
#   cp .env.example .env   and edit the values below.
#
# Compose auto-loads ./.env and substitutes these into docker-compose.yml.
# Running the API locally instead of in Docker? That reads backend/.env, not
# this file.

# --- Postgres ('db' service) ---
# These initialise the db_data volume on first start. Changing them later has
# no effect on an existing volume.
POSTGRES_USER=plex
POSTGRES_PASSWORD=plex
POSTGRES_DB=plex

# --- Backend ('backend' service) ---
# Signs session cookies. Generate one with: openssl rand -hex 32
# Changing it invalidates every existing login.
SESSION_SECRET=change-this-to-a-random-secret-in-production

# Set to true only when the stack is served over HTTPS; otherwise the session
# cookie is marked Secure and the browser silently drops it over plain HTTP.
COOKIE_SECURE=false

# Number of reverse proxies in front of the API (nginx). Rarely needs changing.
# TRUST_PROXY=1

# Fallback Plex server, used for accounts that have no plex_url/plex_token of
# their own saved in the database.
DEFAULT_PLEX_URL=http://your-plex-server-ip:32400
DEFAULT_PLEX_TOKEN=your-plex-token-here

# --- Published ports ---
# Only the frontend is published; the API and database stay on internal
# networks. Uncomment the matching ports block in docker-compose.yml before
# setting BACKEND_PORT or DB_PORT.
FRONTEND_PORT=8088
# BACKEND_PORT=3001
# DB_PORT=5432
